# ── Админка ─────────────────────────────────────────────────────
PORT=3000
# 127.0.0.1 — агент доступен только через nginx/Caddy на этом же сервере (рекомендуется на VPS)
HOST=
# Пароль для входа в админку (минимум 10 символов)
ADMIN_PASSWORD=
# Случайная строка для подписи сессий. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# true, если сайт открыт по https (на сервере — обязательно)
COOKIE_SECURE=false
# Адрес админки на Vercel, если она лежит отдельно от API (несколько — через запятую).
# Должен быть на том же домене, что и API: например https://agent.weartstudio.io
ADMIN_ORIGIN=

# ── Threads (Meta) ──────────────────────────────────────────────
THREADS_APP_ID=
THREADS_APP_SECRET=
# Долгоживущий токен (60 дней). Получить: npm run token -- <короткий_токен>
THREADS_ACCESS_TOKEN=

# ── Нейросеть для текстов (Runware) ─────────────────────────────
# Ключ: my.runware.ai → API Keys
RUNWARE_API_KEY=
# Модели в формате Runware (AIR ID). Проверьте точные ID в каталоге runware.ai/models
FILTER_MODEL=anthropic:claude@haiku-4.5
DRAFT_MODEL=anthropic:claude@sonnet-4.6
# Запасной вариант — Claude API напрямую: AI_PROVIDER=anthropic и ANTHROPIC_API_KEY=...
# (тогда FILTER_MODEL/DRAFT_MODEL — ID моделей Anthropic или удалить строки)

# ── Расписание (cron) ───────────────────────────────────────────
SEARCH_CRON=0 */3 * * *
MENTIONS_CRON=*/15 * * * *

# Ключевые слова, описание продукта, ссылка и лимиты
# настраиваются в админке (раздел «Настройки»).
