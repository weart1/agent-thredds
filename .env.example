# ── Админка ─────────────────────────────────────────────────────
PORT=3000
# Пароль для входа в админку (минимум 10 символов)
ADMIN_PASSWORD=
# Случайная строка для подписи сессий. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# true, если сайт открыт по https (на сервере — обязательно)
COOKIE_SECURE=false

# ── Threads (Meta) ──────────────────────────────────────────────
THREADS_APP_ID=
THREADS_APP_SECRET=
# Долгоживущий токен (60 дней). Получить: npm run token -- <короткий_токен>
THREADS_ACCESS_TOKEN=

# ── Claude API (console.anthropic.com) ──────────────────────────
ANTHROPIC_API_KEY=
FILTER_MODEL=claude-haiku-4-5-20251001
DRAFT_MODEL=claude-sonnet-5-5

# ── Расписание (cron) ───────────────────────────────────────────
SEARCH_CRON=0 */3 * * *
MENTIONS_CRON=*/15 * * * *

# Ключевые слова, описание продукта, ссылка и лимиты
# настраиваются в админке (раздел «Настройки»).
